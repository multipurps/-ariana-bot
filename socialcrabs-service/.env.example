# socialcrabs-service/.env.example
# Copy to .env for local running. On Railway/Render set these as service
# environment variables instead. NEVER commit a filled-in .env.

# ── Required ────────────────────────────────────────────────────────────────
# Shared secret between Ariana and this engine. Refuses to start without it.
# Generate: openssl rand -hex 24
ENGINE_API_KEY=change-me

# Encrypts every stored session at rest (AES-256-GCM). Any passphrase works;
# changing it invalidates stored sessions (they must be provisioned again).
# Generate: openssl rand -hex 32
COOKIE_ENCRYPTION_KEY=change-me-too

# Where sessions live. On Railway/Render this MUST be a mounted volume —
# without one every redeploy logs every account out.
SESSION_DIR=/data/sessions

# ── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=3847

# ── Browser ─────────────────────────────────────────────────────────────────
# How many accounts can have a browser open at once (each costs ~300-600 MB).
# When a new account needs one, the least recently used is closed first.
MAX_BROWSERS=2
# Close an account's browser this many minutes after its last use.
IDLE_SHUTDOWN_MINUTES=20
# Keep headless on a server. A visible browser is only useful with a display.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
# Minimum gap between two write actions on the same account, ±30% jitter.
ACTION_GAP_MS=10000

# Where decrypted sessions are materialised while a browser is running. Defaults
# to the OS temp dir, which is deliberate: plaintext cookies must not sit in the
# mounted volume, in the repo, or anywhere that gets backed up.
# ENGINE_SCRATCH_DIR=/tmp/ariana-social-engine

# ── X / Twitter shortcut (optional) ─────────────────────────────────────────
# Alternative to provisioning a session file for X: two values copied from a
# logged-in browser. The engine builds the session itself. Never commit these.
# SOCIALCRABS_AUTH_TOKEN=
# SOCIALCRABS_CT0=

# ── Local throwaway only ────────────────────────────────────────────────────
# Allows starting without the secrets above. Never set these on a public host.
# ALLOW_NO_API_KEY=1
# ALLOW_INSECURE_SESSION_STORAGE=1
